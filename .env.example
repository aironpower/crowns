# Copia este archivo a .env.local y pega tus claves de Supabase.
# Panel de Supabase → Project Settings → API
#
# Sin estas variables el juego funciona igual, pero sin cuentas ni ranking:
# el historial se guarda solo en el navegador.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# La service_role key NO va aquí nunca: da acceso total y este archivo acaba
# dentro del JavaScript que se descarga el navegador.
